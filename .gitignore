.DS_Store

# Local Claude config stays private, but the sync skills are worth versioning.
.claude/*
!.claude/skills/

# Full-resolution photo originals — optimized web copies live in photos/
_photo-originals/

# Source archives are preserved locally; expanded web projects live in projects/
_project-originals/

# Board sync: the tooling and credentials are local, the generated data is not.
# board-data.js IS committed — it's what the site reads.
projects/climbing/.board-venv/
projects/climbing/.board-cache/
projects/climbing/board-accounts.json
projects/climbing/__pycache__/

# Apex sync: the gamertag is local, the API key lives in the Keychain.
# apex-data.js IS committed — it's what the page reads.
projects/apex/apex-account.json
projects/apex/__pycache__/

# OFFRAMP: the raw OpenStreetMap extracts are build input and re-fetchable
# (data/osm/fetch2.sh, fetch_ramps.sh). 33 MB of them does not belong in a
# Pages repo. The extractor scripts ARE committed, and so is the generated
# corridor the site actually reads: projects/offramp/data/i40.js
projects/offramp/data/osm/*.json
projects/offramp/data/osm/v2/
projects/offramp/data/osm/ramps/
projects/offramp/data/osm/cross/
projects/offramp/data/osm/__pycache__/

# CROSSFIRE room service: wrangler's local state, including a cached copy of
# the Cloudflare account id. The Worker itself IS committed — server/worker.mjs,
# server/rooms-core.mjs and server/wrangler.jsonc are what get deployed.
projects/crossfire/server/.wrangler/

# TRAINING: the public/private split is now built, so this is no longer the
# whole directory — git cannot re-include anything under an excluded directory,
# and server/ and export.mjs have to be committed to be deployable.
#
# What stays private, and why: index.html is the planning app. It holds the
# work rota, the free-hours table, the sleep window and the Apex schedule —
# which together are a weekly timetable of when the house is empty. That is a
# different thing from a training log and it does not go to Pages.
#
# What is public: assets/training-plan.json (sessions, venues and mileage,
# generated by export.mjs), the Worker that stores ticks and notes, and
# training.html which renders them. The exporter is an allowlist, so a new
# private field added to the plan is excluded by default rather than leaked.
projects/training/index.html
projects/training/test/
projects/training/server/.wrangler/
# Strava auto-tick: the client id is a local input, the client secret and the
# webhook verify token live in the macOS Keychain, and the refresh token lives
# in Cloudflare. None of the three are ever in this repo.
projects/training/server/strava-account.json
