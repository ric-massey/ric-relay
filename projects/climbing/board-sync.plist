<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hourly board sync. Install with:

      cp projects/climbing/board-sync.plist ~/Library/LaunchAgents/com.ricmassey.board-sync.plist
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.ricmassey.board-sync.plist

  Remove with:

      launchctl bootout gui/$UID/com.ricmassey.board-sync
      rm ~/Library/LaunchAgents/com.ricmassey.board-sync.plist

  Run it right now without waiting for Sunday:

      launchctl kickstart -p gui/$UID/com.ricmassey.board-sync
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ricmassey.board-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ricmassey/RicsWebsite/projects/climbing/board-sync-weekly.sh</string>
  </array>

  <!-- Hourly. A session logged at the gym ticks its training session off within
       the hour, which is as close as a board gets to the way Strava pushes a
       run. If the Mac is asleep or shut, launchd runs it once on the next wake
       rather than catching up on every hour it missed. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
