{
  // CROSSFIRE room service. Deploy from this directory:
  //     npx wrangler@latest deploy
  //
  // `new_sqlite_classes` rather than `new_classes` is what makes the Durable
  // Object free-plan eligible. The object never writes to that storage — see
  // the note at the top of worker.mjs — but the backend still has to be
  // declared, and it cannot be changed after the namespace is created.
  "name": "crossfire-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomList" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomList"] }],

  // The relay. Optional: with neither of these set the service tells the game
  // "direct connections only" and online play works exactly as it did before —
  // just not for the players who need a relay to connect at all.
  //
  // TURN_KEY_ID is not a secret and can live here once you have made a TURN key
  // in the dashboard (Realtime → TURN). TURN_TOKEN is a secret and must NOT:
  //
  //     npx wrangler@latest secret put TURN_TOKEN
  //
  // "vars": { "TURN_KEY_ID": "…" },

  "observability": { "enabled": true }
}
