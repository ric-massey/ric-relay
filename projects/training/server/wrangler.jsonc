{
  // TRAINING log service. Deploy from this directory:
  //     npx wrangler@latest secret put LOG_TOKEN     # once — this is the gate
  //     npx wrangler@latest deploy
  //
  // Unlike crossfire-rooms, this object genuinely writes to its SQLite storage:
  // a lobby list is worth twenty-five seconds and a training log is worth a
  // year. `new_sqlite_classes` is still what makes it free-plan eligible, and
  // the write volume — one person ticking boxes — sits nowhere near the limit.
  //
  // LOG_TOKEN is a secret, not a var. It must never appear in this file, in
  // worker.mjs, or anywhere else in the repo: this repo is public.
  //
  // Strava, if the auto-tick is wired up (see strava-setup.mjs — it prints the
  // exact commands). All secrets, none of them ever in this file:
  //     STRAVA_CLIENT_ID       the API application's id
  //     STRAVA_CLIENT_SECRET   its secret
  //     STRAVA_REFRESH_TOKEN   a SEED only — Strava rotates it, and from the
  //                            first refresh the live one lives in storage
  //     STRAVA_VERIFY_TOKEN    echoed back during the webhook handshake
  //     STRAVA_ATHLETE_ID      Ric's athlete id, so other people's events stop
  //                            at the door before costing an API call
  // Leave them unset and the Worker runs exactly as it did before: the /strava
  // endpoint records nothing and everything else is untouched.

  // GitHub, for the doorbell on POST /movies/_pull. Adding a film to the
  // Entertainment room is instant; its poster is not, because that comes from
  // a Python script that commits files into the repo, run by a scheduled job.
  // This lets the page skip the wait — it asks this Worker, and this Worker
  // asks GitHub, because a token with write access to the repo cannot live in
  // a public web page and can live here.
  //     npx wrangler@latest secret put GH_TOKEN
  // A fine-grained personal access token on ric-massey/ric-relay, with one
  // permission: Contents → read and write (which is what carries the right to
  // fire a repository_dispatch). It is a secret, not a var, and must never
  // appear in this file. Leave it unset and the route answers "no GitHub
  // token here" and everything else is untouched — so this deploys safely
  // before the token exists.
  //
  // GH_REPO overrides which repository is rung; the default is the site's.
  // A public repository's name is not a credential, so if it ever needs
  // setting it belongs in "vars" below, not in a secret.
  "name": "training-log",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",

  "durable_objects": {
    "bindings": [{ "name": "LOG", "class_name": "TrainingLog" }]
  },

  // Climbing photos and video. The bucket is `photos`, made by hand in the
  // Cloudflare dashboard on 2026-08-19 — so there is no create step here, and
  // renaming it means changing this line and redeploying, nothing else.
  //
  // R2 and not git: a send clip is tens of megabytes and permanent, the repo is
  // already ~500MB, and Pages caps a site around a gigabyte. R2 and not some
  // other bucket: no egress charge, so a video being WATCHED costs nothing,
  // which is the whole point of putting it on a page.
  //
  // Nothing here is a secret — a bucket name is not a credential, and the
  // objects are served through this Worker rather than from a public bucket
  // URL, so there is no bucket to find. Remove this binding and the Worker
  // still runs: /media answers "nothing here" and every page renders as it did
  // before, which is what makes it safe to deploy this ahead of the bucket.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "photos" }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrainingLog"] }],

  "observability": { "enabled": true }
}
